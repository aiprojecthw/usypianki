{
  "expo": {
    "name": "Usypianki",
    "slug": "usypianki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "usypianki",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09132F",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "pl.usypianki.app"
    },
    "android": {
      "package": "pl.usypianki.app",
      "adaptiveIcon": {
        "backgroundColor": "#09132F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09132F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "catalogUrl": "https://bajki.usypianki.com/katalog.json",
      "privacyPolicyUrl": "https://bajki.usypianki.com/polityka-prywatnosci.html",
      "contactEmail": "kontakt@usypianki.com",
      "eas": {
        "projectId": "8d73090e-7faa-45aa-8344-c1d892f9f49c"
      }
    },
    "owner": "aiprojecthws"
  }
}
